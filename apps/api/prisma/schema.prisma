// Prisma schema for BehbodShop

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     String
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  priceToman  Int
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}